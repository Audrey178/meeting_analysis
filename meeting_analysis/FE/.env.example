# Base URL for be/main.py (the FastAPI backend).
# Leave unset in dev — vite.config.ts proxies /health and /meetings to
# http://localhost:8000 so no CORS setup is needed. Set this for a
# production deploy where the API lives on another origin; the backend's
# CORS policy is then controlled by its own ALLOWED_ORIGINS env var.
VITE_API_BASE_URL=
