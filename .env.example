OPENAI_BASE_URL=https://8072--main--nlp--sinhnq3.coder.vts-ai.space/v1
MODEL_NAME=Qwen/Qwen3.8-27B
# Bộ cắt chủ đề DialSTART (bước 2): checkpoint mặc định experiments/dialstart/model_vn3/best.pt
# DIALSTART_CHECKPOINT=
# DIALSTART_DEVICE=                  # cuda / cpu (mặc định: tự chọn)

# src/pipeline: timeout dài cho prompt verifier, giảm số lời gọi LLM song song
OPENAI_TIMEOUT_SECONDS=180
V3_LLM_CONCURRENCY=10
# trần số kết nối mỗi client OpenAI, phải >= các V3_*/VERIFIER_* concurrency
OPENAI_MAX_CONNECTIONS=32
# số task LangGraph song song (chủ đề + verifier)
V3_MAX_CONCURRENCY=64
# Cache kết quả API v3 (be/services/analysis_cache.py): redis (mặc định) | disk | memory | off.
# Redis chạy bằng `docker compose up -d redis` (meeting_analysis/docker-compose.yml).
V3_CACHE=redis
V3_CACHE_REDIS_URL=redis://localhost:6379/0
# thời gian giữ một bản phân tích kể từ lần ghi cuối (giây), mặc định 7 ngày
V3_CACHE_TTL_SECONDS=604800
# chặn gemma sinh không dừng (đã gặp ~3000 dòng JSON chưa đóng)
OPENAI_MAX_OUTPUT_TOKENS=8192

# Verifier (bước 5) chạy trên backend riêng (để trống VERIFIER_MODEL_NAME = dùng chung LLM chính)
VERIFIER_MODEL_NAME=
VERIFIER_BASE_URL=https://api.deepseek.com
VERIFIER_API_KEY=
VERIFIER_RESPONSE_MODE=json_object
# DeepSeek giới hạn ~18 request đồng thời (theo số dư tài khoản)
VERIFIER_LLM_CONCURRENCY=16
# deepseek-flash bật thinking hay trả content toàn khoảng trắng ở json_object -> tắt
VERIFIER_THINKING=disabled

# OpenRouter dùng cho các model benchmark đối chứng và JEV.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
OPENROUTER_JEV_MODEL=typesafe/jev-1.13

# Evidence-check (bước 5) xét lượt chốt theo nghĩa bằng JEV qua OpenRouter.
# Để trống = không bật JEV; candidate chưa chắc chắn sẽ đi Verifier.
TURN_ACT_MODEL=typesafe/jev-1.13
# Hoặc Decisions API của OpenAI (model gpt-6-luna), key OpenAI riêng; base URL mặc định api.openai.com:
# DECISIONS_PROVIDER=openai
# TURN_ACT_MODEL=gpt-6-luna
# DECISIONS_OPENAI_API_KEY=
TURN_ACT_TIMEOUT_SECONDS=30
