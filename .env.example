OPENAI_BASE_URL=https://8072--main--nlp--sinhnq3.coder.vts-ai.space/v1
MODEL_NAME=Qwen/Qwen3.8-27B
# Embedding backend (src/utils/embedding_backend.py): "local" = open-source model
# via sentence-transformers (free, needs `pip install .[local-embeddings]`), "openai" = api.openai.com
# EMBEDDING_BACKEND=local
# EMBEDDING_MODEL=BAAI/bge-m3        # any sentence-transformers model id
# EMBEDDING_DEVICE=                  # cuda / cpu (default: auto)
# EMBEDDING_MAX_SEQ_LENGTH=1024      # token cap per input; lower it if the GPU runs out of memory
# EMBEDDING_TEXT_PREFIX=             # E5 models need "query: "

# agentic_v3: timeout dài cho prompt verifier, giảm số lời gọi LLM song song
OPENAI_TIMEOUT_SECONDS=180
V3_LLM_CONCURRENCY=10
# trần số kết nối mỗi client OpenAI, phải >= các V3_*/VERIFIER_* concurrency
OPENAI_MAX_CONNECTIONS=32
# số task LangGraph song song (chủ đề + verifier)
V3_MAX_CONCURRENCY=64
# chặn gemma sinh không dừng (đã gặp ~3000 dòng JSON chưa đóng)
OPENAI_MAX_OUTPUT_TOKENS=8192

# Verifier của agentic_v3 chạy trên backend riêng (để trống VERIFIER_MODEL_NAME = dùng chung LLM chính)
VERIFIER_MODEL_NAME=
VERIFIER_BASE_URL=https://api.deepseek.com
VERIFIER_API_KEY=
VERIFIER_RESPONSE_MODE=json_object
# DeepSeek giới hạn ~18 request đồng thời (theo số dư tài khoản)
VERIFIER_LLM_CONCURRENCY=16
# deepseek-flash bật thinking hay trả content toàn khoảng trắng ở json_object -> tắt
VERIFIER_THINKING=disabled

# Evidence-check của agentic_v3 xét lượt chốt theo nghĩa bằng OpenAI Decisions API
# (thay luật từ khoá _COMMIT_CUES/_HEDGE_CUES; xem experiments/009_decisions_api). Để trống = luật từ khoá.
TURN_ACT_MODEL=gpt-6-luna
# để trống thì dùng VERIFIER_API_KEY rồi OPENAI_API_KEY
TURN_ACT_API_KEY=
